pipeline {
    agent any

    tools {
        maven 'Maven installations'
        jdk 'jdk21'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/suryaprakashgithubj/Capstone_Project.git'
            }
        }

       stage('Build') {
    steps {
        dir('parabank-automation-framework') {
            sh 'mvn clean compile'
        }
    }
}

stage('Run Tests') {
    steps {
        dir('parabank-automation-framework') {
            sh 'mvn test'
        }
    }
}
    }

    post {
        always {
            archiveArtifacts artifacts: '**/target/surefire-reports/*', allowEmptyArchive: true
        }

        success {
            echo 'Build Successful!'
        }

        failure {
            echo 'Build Failed!'
        }
    }
}